			}
		},
		{
			"path": "pages/my/my",
			"style": {
				"navigationBarTitleText": "我的",
				"enablePullDownRefresh": true // 开启下拉刷新
			}
		},
		{
			"path": "pages/knowledge/knowledge",
			"style": {
				"navigationBarTitleText": "知识库"
			}
		},
		{
			"path": "pages/abilityProfile/abilityProfile",
			"style": {
				"navigationBarTitleText": "能力画像"
			}
		}
	],
	"tabBar": {
		"color": "#BBBAC7",
		"selectedColor": "#2c2c2c",
		"borderStyle": "black",
		"list": [
			{
				"pagePath": "pages/index/index",
				"iconPath": "static/tabs/home_default.png",
				"selectedIconPath": "static/tabs/home_selected.png",
				"text": "首页"
			},
			{
				"pagePath": "pages/abilityProfile/abilityProfile",
				"iconPath": "static/tabs/ability_default.png",
				"selectedIconPath": "static/tabs/ability_selected.png",
				"text": "能力画像"
			},
			{
				"pagePath": "pages/ai/ai",
				"iconPath": "static/tabs/ai_default.png",
				"selectedIconPath": "static/tabs/ai_selected.png",
				"text": "AI 助手"
			},
			{
				"pagePath": "pages/my/my",
				"iconPath": "static/tabs/user_default.png",
				"selectedIconPath": "static/tabs/user_selected.png",
				"text": "我的"
			}
		]
	},
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "uni-app",
		"navigationBarBackgroundColor": "#f5f7fa",
		"backgroundColor": "#fff"
	},
	// ========== 关键新增1：启用微信小程序按需注入（核心） ==========
	"mp-weixin": {
		// 开启按需注入：仅注入当前页面所需的组件/代码
		"lazyCodeLoading": "requiredComponents",
		// 可选：开启分包异步化，提升分包加载效率
		"enableSubpackages": true
	},
	// ========== 关键新增2：开启代码优化，配合懒加载 ==========
	"optimization": {
		// 启用分包优化
		"subPackages": true,
		// 开启摇树优化：删除未使用的代码（核心，减少注入代码量）
		"treeShaking": {
			"enable": true
		}
	},
	"subPackages": [
