{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "student-profile-analyze/output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dimensions"
  ],
  "properties": {
    "dimensions": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "score",
          "level",
          "confidence",
          "evidence"
        ],
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "professional_skill",
              "certificate",
              "innovation",
              "learning",
              "stress_resistance",
              "communication",
              "internship",
              "teamwork",
              "logical_thinking",
              "industry_cognition"
            ]
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "level": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string",
              "maxLength": 40
            }
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 200
    }
  }
}
